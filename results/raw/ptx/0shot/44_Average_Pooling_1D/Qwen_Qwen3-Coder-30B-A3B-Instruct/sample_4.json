plied, shape (batch_size, in_channels, output_length).\n        \"\"\"\n        return self.avg_pool(x)\n\nbatch_size = 64\nin_channels = 128\ninput_length = 65536\nkernel_size = 8\nstride = 1\npadding = 4\n\ndef get_inputs():\n    x = torch.rand(batch_size, in_channels, input_length)\n    return [x]\n\ndef get_init_inputs():\n    return [kernel_size, stride, padding]\n```\n",
